{
  "name": "family-cookbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "migrate:remote": "wrangler d1 migrations apply family-cookbook-db --remote",
