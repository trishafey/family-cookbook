{
  "name": "family-cookbook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/migrate-on-ci.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "migrate:remote": "wrangler d1 migrations apply family-cookbook-db --remote",
    "migrate:local": "wrangler d1 migrations apply family-cookbook-db --local",
    "migrate:status": "wrangler d1 migrations list family-cookbook-db --remote"
  },
  "dependencies": {
    "hono": "^4.12.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "wrangler": "^3.95.0"
  }
}
